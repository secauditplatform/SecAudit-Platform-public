# Demo stand env for https://demo.secaudit.app
# Copy to deploy/compose/.env and fill required secrets. Never commit the filled file.
#
#   openssl rand -hex 32

SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
METRICS_BEARER_TOKEN=

SECRETS_BACKEND=fernet
SECRETS_FERNET_ALLOWED_IN_PRODUCTION=true

POSTGRES_DB=secaudit
POSTGRES_USER=secaudit

AUTH_ENABLED=true
LOCAL_AUTH_ENABLED=true
DEMO_MODE=true

# Unused when VITE_SSO_ENABLED=false (placeholders for prod base compose).
KEYCLOAK_URL=http://127.0.0.1:9
KEYCLOAK_ISSUER=http://127.0.0.1:9/realms/secaudit
KEYCLOAK_REALM=secaudit
KEYCLOAK_CLIENT_ID=secaudit-frontend
KEYCLOAK_AUDIENCE=secaudit-api
VITE_KEYCLOAK_URL=

FRONTEND_BASE_URL=https://demo.secaudit.app
CORS_ORIGINS=https://demo.secaudit.app
FRONTEND_PUBLISH_PORT=127.0.0.1:8080
API_PUBLISH_PORT=127.0.0.1:8000

PROFILES_SOURCE_PATH=../../profiles
PROFILES_AUTO_SEED=false
NOTIFICATIONS_ENABLED=false
SCHEDULED_REPORTS_ENABLED=false

BOOTSTRAP_ADMIN_USERNAME=admin
# Host path relative to deploy/compose (mounted as Docker secret):
BOOTSTRAP_ADMIN_PASSWORD_FILE_HOST=./secrets/bootstrap_admin_password.txt
