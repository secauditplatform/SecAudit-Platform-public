# Copy to deploy/compose/.env and fill every required value.
# Never commit the filled .env file.
#
#   openssl rand -hex 32

# --- Required application secrets ---
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
METRICS_BEARER_TOKEN=

# Fernet is blocked in production unless explicitly opted in during migration.
# Prefer vault / aws_kms for long-lived production.
SECRETS_BACKEND=fernet
SECRETS_FERNET_ALLOWED_IN_PRODUCTION=true

# --- Database ---
POSTGRES_DB=secaudit
POSTGRES_USER=secaudit

# --- Auth / SSO (Keycloak is external) ---
AUTH_ENABLED=true
LOCAL_AUTH_ENABLED=false
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/secaudit
KEYCLOAK_REALM=secaudit
KEYCLOAK_CLIENT_ID=secaudit-frontend
KEYCLOAK_AUDIENCE=secaudit-api
VITE_KEYCLOAK_URL=https://keycloak.example.com

# --- Public URLs ---
FRONTEND_BASE_URL=https://secaudit.example.com
CORS_ORIGINS=https://secaudit.example.com
FRONTEND_PUBLISH_PORT=8080
# Bind API only on localhost by default (frontend proxies /api).
API_PUBLISH_PORT=127.0.0.1:8000

# --- Profiles catalog on the host (relative to deploy/compose) ---
PROFILES_SOURCE_PATH=../../profiles
PROFILES_AUTO_SEED=false

# --- Optional bootstrap local admin (only when users table is empty) ---
# BOOTSTRAP_ADMIN_USERNAME=platform-admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/secaudit_bootstrap_admin_password

# --- Observability profile (docker compose --profile observability) ---
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=
# GRAFANA_PUBLISH_PORT=127.0.0.1:3000
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
