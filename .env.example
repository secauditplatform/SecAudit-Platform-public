# Application
APP_NAME=SecAudit Platform
APP_ENV=development
API_DEBUG=true
# Development default below is rejected when APP_ENV=production.
# For production, set a unique value (openssl rand -hex 32) and keep it identical on api + workers.
# Never copy a placeholder or example string into production.
SECRET_KEY=dev-secret-key
# Optional: isolate local JWT signing from Fernet at-rest encryption (recommended in production).
# LOCAL_JWT_SIGNING_KEY=
# SECRETS_FERNET_KEY=
# When SECRETS_FERNET_KEY is set, new secrets encrypt with it; decrypt still falls back to SECRET_KEY
# for legacy blobs. The console sandbox receives LOCAL_JWT_SIGNING_KEY only (never SECRET_KEY).

# Data-at-rest encryption for credentials, webhook URLs, SMTP/S3 secrets.
# fernet (dev default) | vault (HashiCorp Transit) | aws_kms (BYO-KMS)
SECRETS_BACKEND=fernet
# Production blocks SECRETS_BACKEND=fernet unless explicitly opted in during migration:
# SECRETS_FERNET_ALLOWED_IN_PRODUCTION=false

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=secaudit
POSTGRES_USER=secaudit
POSTGRES_PASSWORD=secaudit_dev

# Redis / Celery (Sentinel HA — default in Docker Compose)
REDIS_URL=redis://secaudit-master/0
CELERY_BROKER_URL=redis://secaudit-master/0
CELERY_RESULT_BACKEND=redis://secaudit-master/1
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_MASTER_NAME=secaudit-master
# REDIS_SENTINEL_PASSWORD=
# REDIS_PASSWORD=
# REDIS_SSL=false
# REDIS_SSL_CERT_REQS=required
# Standalone Redis (optional): docker compose --profile standalone up -d redis
#   REDIS_URL=redis://redis:6379/0
#   CELERY_BROKER_URL=redis://redis:6379/0
#   CELERY_RESULT_BACKEND=redis://redis:6379/1
#   REDIS_SENTINEL_HOSTS=
# Celery task time limits (seconds); stale RUNNING sweeper uses 2x time limit by default
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=3900
STALE_RUN_TIMEOUT_SECONDS=
# Worker health: heartbeat is touched every 60s; readiness/alerts fire after this age
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
# Redis socket deadlines for metrics/health (seconds)
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
BEAT_LOCK_TTL_SECONDS=55
# Worker parallelism and output limits
JOB_HOST_CONCURRENCY=4
JOB_LOG_TTL_SECONDS=86400
RAW_OUTPUT_MAX_CHARS=16000

# Public host for browser/SSO access from other PCs (set to LAN IP now; domain later)
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http

# CORS (comma-separated origins) — include LAN/domain frontend origin for remote SSO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Example LAN: CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173

# Profiles packages path inside containers (mounted volume for discovery)
PROFILES_PATH=/profiles

# Host path with profile packages, mounted read-only into /profiles (compose).
# Packages are not shipped in this repository — see profiles/README.md.
PROFILES_SOURCE_PATH=./profiles

# Auto-import bundled profiles from /profiles on API startup (skip already imported)
PROFILES_AUTO_SEED=false

# Periodic Celery beat sync: import new packages from /profiles mount
PROFILES_CATALOG_SYNC_ENABLED=false
PROFILES_CATALOG_SYNC_INTERVAL_SECONDS=3600
PROFILES_CATALOG_SYNC_UPDATE_EXISTING=true

# Persistent storage for imported profile packages
PROFILES_STORAGE_PATH=/data/profiles

# Notifications (optional global SMTP fallback for email channels)
NOTIFICATIONS_ENABLED=true
FRONTEND_BASE_URL=http://localhost:5173
# Example LAN: FRONTEND_BASE_URL=http://192.168.1.100:5173
# Local catch-all SMTP (Mailpit UI: http://localhost:8025). For real Gmail:
# SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=... SMTP_PASSWORD=<app-password> SMTP_USE_TLS=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=secaudit@localhost
SMTP_USE_TLS=false

# Scheduled reports (optional global S3 fallback)
SCHEDULED_REPORTS_ENABLED=true
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=reports

# Auth (Keycloak SSO + optional local DB users via Users UI)
AUTH_ENABLED=true
# Public demo stand: block execute/mutate APIs; UI syncs via /api/v1/health demo_mode.
# DEMO_MODE=false
# When true, username/password login uses accounts managed under Users.
# There is no env-backed fallback account (dev/dev removed).
LOCAL_AUTH_ENABLED=false
# LOCAL_AUTH_REVALIDATE_FROM_DB=true
# Opt-in first local admin — created only when the users table is empty.
# Never use placeholder values (dev, admin, password, …). Unset after first login.
# BOOTSTRAP_ADMIN_USERNAME=platform-admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# BOOTSTRAP_ADMIN_EMAIL=platform-admin@example.com
# Production: mount password from secret storage instead of BOOTSTRAP_ADMIN_PASSWORD:
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/secaudit_bootstrap_admin_password
# JWKS base URL (use http://keycloak:8080 inside Docker; localhost when API runs on host)
KEYCLOAK_URL=http://localhost:8080
# Token iss claim — public Keycloak URL (browser/SSO); must match PUBLIC_HOST for LAN access
KEYCLOAK_ISSUER=http://localhost:8080/realms/secaudit
# Example LAN: KEYCLOAK_ISSUER=http://192.168.1.100:8080/realms/secaudit
# Browser-facing Keycloak URL (frontend Vite). Same host as KEYCLOAK_ISSUER.
VITE_KEYCLOAK_URL=http://localhost:8080
# Example LAN: VITE_KEYCLOAK_URL=http://192.168.1.100:8080
KEYCLOAK_REALM=secaudit
KEYCLOAK_CLIENT_ID=secaudit-frontend
KEYCLOAK_AUDIENCE=secaudit-api

# Web console — prefer the isolated `console` Compose service (sandbox).
# Prod: leave CONSOLE_ENABLED=false unless CONSOLE_ALLOW_IN_PRODUCTION=true.
CONSOLE_ENABLED=true
CONSOLE_SANDBOX_ENABLED=true
CONSOLE_SANDBOX_URL=http://console:8001
CONSOLE_SESSION_TIMEOUT_SECONDS=3600
# CONSOLE_ALLOW_IN_PRODUCTION=false

# SSH host key verification (worker)
# Strict by default when APP_ENV=production; relaxed in development
# SSH_STRICT_HOST_KEY_CHECKING=true
# SSH_KNOWN_HOSTS_PATH=/path/to/known_hosts

# WinRM TLS certificate validation (worker/ansible)
# validate in production, ignore in development
# WINRM_SERVER_CERT_VALIDATION=validate

# Local auth rate limit + refresh tokens (API)
# LOCAL_AUTH_RATE_LIMIT_ENABLED=true
# LOCAL_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# LOCAL_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated reverse-proxy peer IPs allowed to set X-Forwarded-For for login rate limits.
# TRUSTED_PROXY_IPS=172.18.0.1,10.0.0.1
# LOCAL_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Vault Transit (when SECRETS_BACKEND=vault)
VAULT_ADDR=
VAULT_TOKEN=
# VAULT_TOKEN_FILE=/run/secrets/vault_token
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TRANSIT_KEY=secaudit

# AWS KMS (when SECRETS_BACKEND=aws_kms)
# AWS_KMS_KEY_ID=arn:aws:kms:region:account:key/...
# AWS_KMS_REGION=us-east-1

# OpenTelemetry tracing (opt-in). Run `docker compose --profile observability up -d`
# to start bundled Tempo (OTLP HTTP :4318) and Grafana (:3001) stack.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SAMPLER_RATIO=1.0
# Per-service names (defaults are usually fine)
# OTEL_SERVICE_NAME_API=secaudit-api
# OTEL_SERVICE_NAME_WORKER=secaudit-worker
# OTEL_SERVICE_NAME_BEAT=secaudit-beat
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=staging,team=security

# Migrations (API lifespan). Prefer a single pre-start `alembic upgrade head` in
# multi-replica deploys; concurrent replicas serialize via PostgreSQL advisory lock.
# SKIP_MIGRATIONS=1
# ALLOW_LEGACY_ALEMBIC_STAMP=1   # only after validating schema matches head

# Observability endpoint protection (Bearer or X-Observability-Token).
# In production, METRICS_BEARER_TOKEN is required or /metrics returns 503.
# METRICS_BEARER_TOKEN=
# READINESS_BEARER_TOKEN=
# READINESS_CACHE_SECONDS=5
# READINESS_REDACT_DETAILS=true
# METRICS_SCRAPE_TIMEOUT_SECONDS=5
# BLOCKING_IO_TIMEOUT_SECONDS=60
